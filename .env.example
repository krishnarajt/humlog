# ---------------------------------------------------------------------------
# hum.log backend
#
# Every key below is read straight from the environment. In the cluster they
# arrive as one Vault record — see k8s/base/externalsecret.yaml — so this file
# is both the local .env and the list of what that record has to contain.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://humlog:humlog@localhost:5432/humlog
# The app runs `alembic upgrade head` itself on startup. Set to false only to
# fall back to create_all(), which builds the schema but records no revision.
USE_ALEMBIC_MIGRATIONS=true

# Authentication
# Generate with: openssl rand -hex 32
# Also salts the hash of a commenter's IP address, so changing it orphans
# existing comment rate limits (harmless) and existing "remove everything from
# this commenter" links (they stop matching older comments).
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# S3 / MinIO — pasted images
#
# Called MINIO_* because that is what the other backends in this cluster call
# them and because it is the same MinIO behind them; nothing here is
# MinIO-specific. Point MINIO_ENDPOINT at AWS and the same boto3 code talks to
# S3. The bucket is created on first use if it does not exist.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://your-minio-endpoint:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=humlog
MINIO_REGION=us-east-1

# ---------------------------------------------------------------------------
# Email — the forgotten-password code, and nothing else
#
# A Gmail account with an app password. Not the account password: Google will
# refuse that. Generate one at https://myaccount.google.com/apppasswords with
# 2-Step Verification switched on, and paste the 16 characters with or without
# the spaces.
#
# Optional. With SMTP_USER or SMTP_PASSWORD unset, sends are logged and
# skipped and the rest of the app is unaffected — what it costs is password
# resets, which will look like they worked and never arrive. The startup log
# says so in as many words.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER. Set it if you send from an alias.
SMTP_FROM=
SMTP_FROM_NAME=hum.log

# Where this deployment is reachable from the internet — scheme and host, no
# path. Exported posts embed absolute image URLs built from it
# (`{PUBLIC_BASE_URL}/api/images/{uuid}/raw`), so without it a downloaded
# export has relative image links that only work on the same origin.
PUBLIC_BASE_URL=https://blog.krishnarajthadesar.in

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://humlog.vercel.app

# Logging
LOG_LEVEL=INFO

# Server
PORT=8000
RELOAD=false
